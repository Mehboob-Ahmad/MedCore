# MedCore Monorepo Environment Variables
# Copy this to .env and configure accordingly

# Environment
NODE_ENV=development

# API Settings
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=medcore_secret
POSTGRES_DB=medcore

# JWT Secrets (Do NOT use these in production)
JWT_SECRET=super_secret_development_jwt_key_12345!
JWT_ISSUER=medcore.local
JWT_AUDIENCE=medcore.local

# Redis
REDIS_URL=redis://localhost:6379
